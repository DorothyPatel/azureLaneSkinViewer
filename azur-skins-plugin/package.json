{
  "name": "@local/azur-skins",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "碧蓝航线立绘图鉴：浏览全部舰船立绘与皮肤立绘，按舰种/阵营/稀有度筛选，打分、写评语、收藏。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
